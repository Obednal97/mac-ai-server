# Defaults. Override in ~/.mac-ai-server/config.env or in the environment.
MAS_HOSTNAME=ai-mini
MAS_MODE=auto
MAS_TAILSCALE=yes
MAS_AGENT_MODE=no
MAS_HANDOVER=no
MAS_MULTIUSER=no
MAS_WIREGUARD=no
MAS_WG_ENDPOINT=
MAS_WG_PORT=51820
MAS_MODEL=
MAS_OLLAMA_LAN=no
MAS_REMOVE_APPS=no
MAS_SUDO=terminal
MAS_AGENT_TOOLS=yes
MAS_STATUSLINE=yes
MAS_SQUAD=yes
MAS_SQUAD_SKIP_PERMISSIONS=no
MAS_PLUGINS="superpowers code-review frontend-design playwright"
MAS_SEARCH=duckduckgo
MAS_SEARXNG_URL=
MAS_DEV_TOOLS="node pnpm uv git gh jq ripgrep"
MAS_TMUX_ATTACH=yes
