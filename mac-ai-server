#!/bin/bash
# mac-ai-server: the everyday command. Run `mac-ai-server help` for the list.
# Env (tests): MAS_INSTALL_SH, MAS_HANDOVER_SCRIPT, MAS_MODULES_DIR.

# Find the repo even when run through the ~/.local/bin symlink.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
MAS_ROOT="$(cd "$(dirname "$_src")" && pwd)"
unset _src _dir

PATH="$PATH:${MAS_BREW_PREFIX:-/opt/homebrew}/bin"; export PATH   # appended, so a user's own tools win

# Same config order as install.sh: defaults, then the user's file; anything already in the environment wins.
_mas_env="$(export -p | grep '^declare -x MAS_')"
# shellcheck source=config/defaults.env
. "$MAS_ROOT/config/defaults.env"
# shellcheck disable=SC1090,SC1091
[ -f "$HOME/.mac-ai-server/config.env" ] && . "$HOME/.mac-ai-server/config.env"
eval "$_mas_env"
unset _mas_env
# shellcheck source=lib/common.sh
. "$MAS_ROOT/lib/common.sh"
# shellcheck source=lib/wireguard.sh
. "$MAS_ROOT/lib/wireguard.sh"

MAS_CONFIG="$HOME/.mac-ai-server/config.env"
MAS_INSTALL_SH="${MAS_INSTALL_SH:-$MAS_ROOT/install.sh}"
MAS_USER_MODEL="${MAS_MODEL:-}"   # what the user chose; empty means "follow the recommendation"

usage() {
  cat <<'USAGE'
mac-ai-server: look after your AI server

  mac-ai-server update               Get the latest version and apply it
  mac-ai-server doctor               Check that everything is working
  mac-ai-server doctor --report      Same, with personal details removed, safe to share
  mac-ai-server models               Show the AI models that fit this Mac
  mac-ai-server models default <m>   Use a different model for claude-local and chat
  mac-ai-server models add-fast      Download the quick helper model
  mac-ai-server models remove <m>    Delete a downloaded model
  mac-ai-server tools                Show, add or remove developer tools (tools add <name>)
  mac-ai-server permissions          Walk through the macOS permissions
  mac-ai-server users                Show the accounts; users add <name> [--wireguard] / card / remove
  mac-ai-server token set            Log Claude Code in without the keychain (claude setup-token)
  mac-ai-server handover <step>      Prepare this Mac for a new owner (phase1, phase2, local, dry-run)
  mac-ai-server install [options]    Run the installer again (--plan shows what it would do)
  mac-ai-server help                 Show this list
USAGE
}

load_hw() {  # hardware + model plan
  # shellcheck source=lib/detect.sh
  . "$MAS_ROOT/lib/detect.sh"
  # shellcheck source=lib/plan.sh
  . "$MAS_ROOT/lib/plan.sh"
}

config_set() {  # config_set KEY VALUE (already quoted if needed)
  local tmp
  mkdir -p "$(dirname "$MAS_CONFIG")"
  touch "$MAS_CONFIG"
  tmp="$(mktemp "$MAS_CONFIG.XXXXXX")" || mas_die "Couldn't write $MAS_CONFIG."
  grep -v "^$1=" "$MAS_CONFIG" > "$tmp"
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  mv "$tmp" "$MAS_CONFIG"
}

# A model tag or tool name: safe characters only, and never a leading '-' (it would read as an option).
valid_tag() { case "$1" in ""|-*|*[!A-Za-z0-9._:/@-]*) return 1 ;; *) return 0 ;; esac; }

installed_default() {  # model claude-local currently uses, else empty
  sed -n 's/.*CLAUDE_LOCAL_MODEL:-\([^}]*\)}.*/\1/p' "$HOME/.local/bin/claude-local" 2>/dev/null | head -1
}

downloaded_models() { ollama list 2>/dev/null | awk 'NR>1{print $1}'; }
have_model() { downloaded_models | grep -Fxq "$1"; }

# ---------------------------------------------------------------- commands
# Refresh the optional status line kit when it was installed. A failure only warns.
update_statusline() {
  local kit="$HOME/claude-statusline-kit"
  [ "${MAS_STATUSLINE:-yes}" = yes ] || return 0
  [ -f "$kit/update.sh" ] || return 0
  echo "Updating the Claude Code status line..."
  PATH="${MAS_BREW_PREFIX:-/opt/homebrew}/bin:$PATH" /bin/bash "$kit/update.sh" \
    || echo "The status line update didn't work. Try: mac-ai-server install --only statusline" >&2
  return 0
}

cmd_update() {
  local cur rec
  if ! git -C "$MAS_ROOT" pull --ff-only; then
    echo "Couldn't update: this copy of mac-ai-server has changes of its own, or has drifted from the original." >&2
    echo "To see what's different, run: git -C \"$MAS_ROOT\" status" >&2
    echo "Then undo the changes (git -C \"$MAS_ROOT\" stash) and run update again, or ask for help." >&2
    return 1
  fi
  cur="$(installed_default)"
  # Keep the model in use: an update must not quietly switch to (and download) a bigger one.
  if [ -n "$cur" ] && [ -z "$MAS_USER_MODEL" ]; then
    MAS_MODEL="$cur" "$MAS_INSTALL_SH" --yes || return 1
  else
    "$MAS_INSTALL_SH" --yes || return 1
  fi
  update_statusline
  load_hw
  rec="$( MAS_MODEL=""; mas_plan_model >/dev/null 2>&1 && echo "$MAS_PRIMARY" )"
  if [ -z "$MAS_USER_MODEL" ] && [ -n "$cur" ] && [ -n "$rec" ] && [ "$cur" != "$rec" ]; then
    echo
    echo "Recommended model changed: $cur → $rec. Run: mac-ai-server models default $rec"
  fi
}

# Escape a literal for use inside a sed regex.
sed_lit() { printf '%s' "$1" | sed 's/[][\.*^$/+?(){}|]/\\&/g'; }

cmd_doctor() {
  local report=0 raw rc names n
  [ "${1:-}" = "--report" ] && report=1
  if [ "$report" = 0 ]; then
    "$MAS_INSTALL_SH" --check
    return $?
  fi
  load_hw
  raw="$("$MAS_INSTALL_SH" --check 2>&1)"; rc=$?
  echo "Chip: $MAS_CHIP"
  echo "Memory: ${MAS_RAM_GB} GB"
  echo "macOS: $MAS_MACOS"
  echo
  names="$(hostname -s 2>/dev/null; hostname 2>/dev/null; scutil --get LocalHostName 2>/dev/null
           scutil --get ComputerName 2>/dev/null; id -un; printf '%s\n' "${MAS_HOSTNAME:-}"
           networksetup -getairportnetwork "${MAS_WIFI_DEV:-en0}" 2>/dev/null | sed -n 's/^Current Wi-Fi Network: //p')"
  # Strip colour codes and the home folder, then addresses, then every personal name we know.
  raw="$(printf '%s\n' "$raw" | sed -e $'s/\033\\[[0-9;]*m//g' -e "s|$(sed_lit "$HOME")|~|g")"
  raw="$(printf '%s\n' "$raw" | sed -E \
    -e 's/([0-9]{1,3}\.){3}[0-9]{1,3}/<ip>/g' \
    -e 's/([0-9a-fA-F]{1,4}:){3,7}[0-9a-fA-F]{1,4}/<ip>/g' \
    -e 's/([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}/<mac>/g' \
    -e 's/[A-Za-z0-9-]+\.ts\.net/<tailnet-name>/g' \
    -e 's/(SSID|Wi-Fi network)[:= ]+[^,;]*/\1 <hidden>/g')"
  while IFS= read -r n; do
    [ "${#n}" -ge 2 ] || continue
    raw="$(printf '%s\n' "$raw" | sed -E "s/$(sed_lit "$n")/<redacted>/gI")"
  done <<NAMES
$names
NAMES
  printf '%s\n' "$raw"
  return "$rc"
}

cmd_models() {
  local sub="${1:-list}" tag opts size label mark dl flags cur
  case "$sub" in
    list)
      load_hw
      mas_plan_model || mas_die "Couldn't work out which model fits this Mac."
      cur="$(installed_default)"; cur="${cur:-$MAS_PRIMARY}"
      echo "AI models that fit this Mac (${MAS_RAM_GB} GB memory):"
      opts="$(mas_model_options)"
      dl="$(downloaded_models)"
      while IFS="$(printf '\t')" read -r tag size label mark; do
        [ -n "$tag" ] || continue
        flags=""
        [ "$tag" = "$cur" ] && flags="$flags [in use]"
        printf '%s\n' "$dl" | grep -Fxq "$tag" && flags="$flags [downloaded]"
        [ -n "$mark" ] && flags="$flags [recommended]"
        printf '  %s (%s GB): %s%s\n' "$tag" "$size" "$label" "$flags"
      done <<OPTS
$opts
OPTS
      echo
      echo "Switch with: mac-ai-server models default <name>"
      ;;
    default)
      tag="${2:-}"
      valid_tag "$tag" || mas_die "Give a model name, like: mac-ai-server models default qwen3.6:27b"
      if ! have_model "$tag"; then
        echo "Downloading $tag first. This can take a while."
        ollama pull "$tag" || mas_die "Couldn't download $tag, so nothing was changed. Check the name and your internet connection."
      fi
      config_set MAS_MODEL "$tag"
      MAS_MODEL="$tag" "$MAS_INSTALL_SH" --yes --only claude \
        || mas_die "Saved $tag, but couldn't refresh claude-local and chat. Run: mac-ai-server install --only claude"
      echo "claude-local and chat now use $tag."
      ;;
    add-fast)
      load_hw
      mas_plan_model || mas_die "Couldn't work out which model fits this Mac."
      if [ -z "$MAS_FAST" ] || [ "$MAS_FAST" = "$MAS_PRIMARY" ]; then
        echo "This Mac doesn't need a separate quick helper model."; return 0
      fi
      ollama pull "$MAS_FAST" || mas_die "Couldn't download $MAS_FAST. Check your internet connection and try again."
      echo "Quick helper model $MAS_FAST is ready. Use it with: chat $MAS_FAST"
      ;;
    remove)
      tag="${2:-}"
      valid_tag "$tag" || mas_die "Give a model name, like: mac-ai-server models remove qwen3.6:27b"
      cur="$(installed_default)"
      if [ "$tag" = "$cur" ] || [ "$tag" = "$MAS_USER_MODEL" ]; then
        mas_die "$tag is the model in use. Pick another first: mac-ai-server models default <name>"
      fi
      ollama rm "$tag"
      ;;
    *) mas_die "Unknown models option '$sub'. Try: list, default <name>, add-fast, remove <name>" ;;
  esac
}

cmd_tools() {
  local sub="${1:-list}" f="${2:-}" cur new t found
  cur="${MAS_DEV_TOOLS-}"   # the default is in config/defaults.env, loaded above
  case "$sub" in
    list) echo "Developer tools: $cur"; return 0 ;;
    add|remove)
      case "$f" in ""|-*|*[!A-Za-z0-9@._+/-]*) mas_die "Give a tool name, like: mac-ai-server tools $sub ripgrep" ;; esac
      new=""; found=0
      for t in $cur; do
        if [ "$t" = "$f" ]; then
          found=1
          [ "$sub" = remove ] && continue
        fi
        new="$new $t"
      done
      new="${new# }"
      if [ "$sub" = add ] && [ "$found" = 0 ]; then new="${new:+$new }$f"; fi
      config_set MAS_DEV_TOOLS "\"$new\""
      if [ "$sub" = remove ]; then
        # Only the list changes: nothing is uninstalled (other tools may depend on it).
        echo "Stopped tracking $f: the installer won't install or check it any more."
        echo "It is still installed. To uninstall it too, run: brew uninstall $f"
        return 0
      fi
      MAS_DEV_TOOLS="$new" "$MAS_INSTALL_SH" --yes --only homebrew
      ;;
    *) mas_die "Unknown tools option '$sub'. Try: list, add <name>, remove <name>" ;;
  esac
}

cmd_permissions() {
  local mod="${MAS_MODULES_DIR:-$MAS_ROOT/modules}/95-permissions.sh"
  [ -f "$mod" ] || mas_die "The permissions guide is missing. Run: mac-ai-server update"
  load_hw
  if [ "$MAS_MODE" = auto ]; then
    if [ "$MAS_LAPTOP" = 1 ]; then MAS_MODE=laptop-daily; else MAS_MODE=desktop; fi
  fi
  export MAS_MODE
  # shellcheck disable=SC1090  # chosen at run time
  ( . "$mod"; mod_run; mod_check )
}

# ---------------------------------------------------------------- users (multi-user)
valid_user() { case "$1" in ""|[!a-z]*|*[!a-z0-9._-]*) return 1 ;; *) [ "${#1}" -le 31 ] ;; esac; }
user_home() { dscl . -read "/Users/$1" NFSHomeDirectory 2>/dev/null | awk '{print $2}'; }
is_admin() { dseditgroup -o checkmember -m "$1" admin >/dev/null 2>&1; }
people() { dscl . -list /Users UniqueID 2>/dev/null | awk '$2 >= 501 {print $1}'; }
dq() { local s="${1//\\/\\\\}"; s="${s//\"/\\\"}"; printf '"%s"' "$s"; }   # quote for dscl's stdin
USERS_DIR="$HOME/.mac-ai-server/users"   # each person's info pack, private to you
# A fixed amount of randomness per piece (an endless `tr </dev/urandom | head` hangs where SIGPIPE is ignored).
pw_seg() {
  local s=""
  while [ "${#s}" -lt 4 ]; do s="$s$(head -c 64 /dev/urandom | LC_ALL=C tr -dc 'abcdefghjkmnpqrstuvwxyz23456789')"; done
  printf '%s' "${s:0:4}"
}
temp_pw() { printf '%s-%s-%s' "$(pw_seg)" "$(pw_seg)" "$(pw_seg)"; }
# This Mac's full Tailscale name (MagicDNS), or empty
ts_name() {
  "${MAS_BREW_PREFIX:-/opt/homebrew}/bin/tailscale" status --json 2>/dev/null \
    | /usr/bin/python3 -I -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null
}
private_write() {  # private_write <file>: stdin to a new 0600 file
  rm -f "$1"; ( umask 077; cat > "$1" )
}

# render_card <name>: the info pack's card, from what users add saved in $USERS_DIR/<name>
render_card() {
  local name="$1" d="$USERS_DIR/$1" pw method link tsn host conf
  pw="$(cat "$d/temp-password" 2>/dev/null)"; method="$(cat "$d/method" 2>/dev/null)"; link="$(cat "$d/tailscale-link" 2>/dev/null)"
  host="$(scutil --get LocalHostName 2>/dev/null)"; host="${host:-this-mac}"
  cat <<CARD
YOUR ACCOUNT ON THE AI MAC "$host"

Your account:        $name
Temporary password:  ${pw:-(ask whoever set it up)}
The first time you log in over SSH, you're asked to choose your own password.
(Only using Screen Sharing? Change it in System Settings > Users & Groups.)

CARD
  if [ "$method" = wireguard ]; then
    conf="$name-$host.conf"
    cat <<CARD
1. Install the free WireGuard app: https://www.wireguard.com/install/
   (no account or sign-up needed)
2. Add the tunnel: in WireGuard choose "Import tunnel(s) from file" and pick
   the file $conf that came with this card. On a phone, scan the QR code
   ($name-$host.png) instead.
3. Switch the tunnel on in the WireGuard app, then connect from Terminal:
     ssh $name@$(mas_wg_net).1
   The first time, it asks whether to trust this computer: type yes.
   "Connection timed out" means the tunnel is off, or tell whoever set it up.
   Screen Sharing (Mac: Finder > Go > Connect to Server):  vnc://$(mas_wg_net).1
   The tunnel only reaches this Mac, nothing else on its network.
CARD
  else
    tsn="$(cat "$d/tailscale-name" 2>/dev/null)"; tsn="${tsn:-$host}"
    [ -n "$link" ] || link="(you will get the link separately)"
    cat <<CARD
1. Install Tailscale: https://tailscale.com/download
   Sign in with YOUR OWN account (free; Google, Apple, GitHub or email).
2. Open this invite link and accept it, to add the Mac to your Tailscale:
   $link
   You only get access to this one Mac.
3. With Tailscale switched on, connect from Terminal:
     ssh $name@$tsn
   The first time, it asks whether to trust this computer: type yes.
   Screen Sharing (Mac: Finder > Go > Connect to Server):  vnc://$tsn
CARD
  fi
  cat <<CARD

Once you're in:
  claude          Claude Code. Log in with your own Claude account the first time.
  claude-local    Claude Code on this Mac's own AI model (private, free, slower)
  chat            a quick chat with the local model
  tmux new -As main   keeps your work running when you disconnect (Ctrl-b d to leave it)

Your files, projects and Claude login are private to you. The AI models are shared.
CARD
}

users_list() {
  local u tag
  echo "Accounts on this Mac:"
  for u in $(people); do
    tag="standard"; is_admin "$u" && tag="administrator"
    [ "$u" = "$(id -un)" ] && tag="$tag, you"
    [ -f "$USERS_DIR/$u/method" ] && tag="$tag, via $(cat "$USERS_DIR/$u/method")"
    printf '  %s (%s)\n' "$u" "$tag"
  done
  [ "${MAS_MULTIUSER:-no}" = yes ] || echo "Multi-user mode is off. mac-ai-server users add <name> turns it on."
}

users_add() {
  local name="" full="" method=tailscale a h g out pw throw d conf host link
  for a in "$@"; do
    case "$a" in
      --wireguard) method=wireguard ;;
      --tailscale) method=tailscale ;;
      -*) mas_die "Unknown option '$a'. Try: mac-ai-server users add <name> [\"Full Name\"] [--wireguard]" ;;
      *) if [ -z "$name" ]; then name="$a"; else full="$a"; fi ;;
    esac
  done
  valid_user "$name" || mas_die "Give a short account name: lower-case letters, numbers, . _ or -, starting with a letter. Like: mac-ai-server users add sam"
  id "$name" >/dev/null 2>&1 && mas_die "There's already an account called $name."
  if [ "$method" = wireguard ] && { [ "${MAS_WIREGUARD:-no}" != yes ] || [ -z "${MAS_WG_ENDPOINT:-}" ] || ! sudo test -f "$(mas_wg_conf)"; }; then
    mas_die "WireGuard isn't set up. Set MAS_WIREGUARD=yes and MAS_WG_ENDPOINT in ~/.mac-ai-server/config.env, run: mac-ai-server install --only wireguard, then try again."
  fi
  if [ "${MAS_MULTIUSER:-no}" != yes ]; then
    echo "Turning on multi-user mode first (your home folder becomes private, claude-local and chat are shared)."
    MAS_MULTIUSER=yes "$MAS_INSTALL_SH" --yes --only claude,multiuser || mas_die "Couldn't turn on multi-user mode, so no account was added."
    config_set MAS_MULTIUSER yes
  fi
  # Created with a throwaway password, which is replaced at once through dscl's standard input,
  # so the password they get never appears in a command line.
  throw="$(temp_pw)$(temp_pw)"
  sudo sysadminctl -addUser "$name" -fullName "${full:-$name}" -password "$throw" >/dev/null 2>&1
  throw=""
  id "$name" >/dev/null 2>&1 || mas_die "macOS didn't create the account $name."
  pw="$(temp_pw)"
  # As root, dscl sets a password without the old one. It answers just "Goodbye" when it worked
  # (TERM=dumb: with a terminal type it doesn't know, like xterm-ghostty, it also prints a warning).
  out="$(printf 'passwd %s %s\n' "$(dq "/Users/$name")" "$(dq "$pw")" | sudo env TERM=dumb dscl . 2>&1)"
  [ "$out" = Goodbye ] || mas_die "Created $name, but couldn't set their password. Set one with: sudo passwd $name"
  sudo createhomedir -c -u "$name" >/dev/null 2>&1 || true
  h="$(user_home "$name")"
  # Private, like yours: macOS makes new home folders readable by every account.
  { [ -n "$h" ] && sudo chmod 700 "$h"; } || mas_warn "Couldn't make $name's home folder private. Run: sudo chmod 700 /Users/$name"
  # SSH and Screen Sharing are limited to these groups when they exist (by default only admins are in them).
  for g in com.apple.access_ssh com.apple.access_screensharing; do
    dscl . -read "/Groups/$g" >/dev/null 2>&1 && sudo dseditgroup -o edit -a "$name" -t user "$g"
  done
  echo "Installing Claude Code for $name..."
  cd / || true   # their shell starts here: your home folder is private to them
  # shellcheck disable=SC2016  # runs in the new account's own shell
  sudo -u "$name" -H /bin/bash -c '
    cd "$HOME" || exit 1
    curl -fsSL https://claude.ai/install.sh | bash >/dev/null 2>&1 || echo "Claude Code install failed; they can run: curl -fsSL https://claude.ai/install.sh | bash"
    touch .zshrc .zprofile
    grep -q ".local/bin" .zshrc || echo "export PATH=\"\$HOME/.local/bin:\$PATH\"" >> .zshrc
    touch .mas-new-password
    grep -q "mas-new-password" .zprofile || cat >> .zprofile <<'"'"'BLOCK'"'"'

# mac-ai-server: first login on a shared Mac
if [ -f ~/.mas-new-password ] && [ -t 0 ]; then
  echo "Welcome. First, choose your own password (you will need the temporary one once more)."
  passwd && rm -f ~/.mas-new-password
fi
if [ -t 1 ]; then
  echo "This Mac runs a shared local AI model. Try: claude (log in with your own Claude account),"
  echo "claude-local (Claude Code on the local model) or chat. Your files are private to you."
fi
BLOCK
  '
  mas_mu_install_plugins "$name" "$h" || true

  # The info pack: card, plus their WireGuard file and QR code. Private to you; send it privately.
  d="$USERS_DIR/$name"; mkdir -p "$d" && chmod 700 "$USERS_DIR" "$d"
  printf '%s\n' "$pw" | private_write "$d/temp-password"; pw=""
  printf '%s\n' "$method" | private_write "$d/method"
  host="$(scutil --get LocalHostName 2>/dev/null)"; host="${host:-this-mac}"
  if [ "$method" = wireguard ]; then
    conf="$(mas_wg_add_peer "$name")" || mas_die "Created $name, but couldn't give them a WireGuard key. Try: mac-ai-server users remove $name, then add them again."
    printf '%s\n' "$conf" | private_write "$d/$name-$host.conf"; conf=""
    "${MAS_BREW_PREFIX:-/opt/homebrew}/bin/qrencode" -o "$d/$name-$host.png" -r "$d/$name-$host.conf" 2>/dev/null && chmod 600 "$d/$name-$host.png"
  else
    a="$(ts_name)"; [ -n "$a" ] && printf '%s\n' "$a" | private_write "$d/tailscale-name"
    echo
    echo "Now share this Mac with them in Tailscale. They sign in with their own account and only see this Mac:"
    echo "  login.tailscale.com/admin/machines > $(cat "$d/tailscale-name" 2>/dev/null || echo "$host") > ... > Share... > copy the invite link"
    read -r -p "Paste the invite link (or press Enter to add it later): " link || link=""
    case "$link" in https://*) printf '%s\n' "$link" | private_write "$d/tailscale-link" ;; esac
  fi
  render_card "$name" | private_write "$d/card.txt"
  echo
  render_card "$name"
  echo
  echo "Saved to $d (only you can read it). Send it to $name privately."
  [ "$method" = wireguard ] && echo "Include the file $d/$name-$host.conf (or the QR code next to it)."
  [ "$method" = tailscale ] && [ ! -f "$d/tailscale-link" ] && echo "When you have the invite link: mac-ai-server users card $name --link <link>"
  return 0
}

users_card() {
  local name="${1:-}" d
  valid_user "$name" || mas_die "Say whose card to show. Like: mac-ai-server users card sam"
  d="$USERS_DIR/$name"
  [ -d "$d" ] || mas_die "No info pack for $name (it's made by mac-ai-server users add)."
  if [ "${2:-}" = --link ]; then
    case "${3:-}" in https://*) printf '%s\n' "$3" | private_write "$d/tailscale-link" ;; *) mas_die "Give the Tailscale invite link, starting with https://" ;; esac
  fi
  render_card "$name" | private_write "$d/card.txt"
  render_card "$name"
  echo; echo "(Saved to $d/card.txt. If $name has changed their password, the temporary one no longer works.)"
}

users_remove() {
  local name="${1:-}" ok method out g
  valid_user "$name" || mas_die "Say which account to remove. Like: mac-ai-server users remove sam"
  people | grep -qx "$name" || mas_die "There's no person's account called $name (system accounts can't be removed here)."
  [ "$name" = "$(id -un)" ] && mas_die "That's your own account."
  is_admin "$name" && mas_die "$name is an administrator. Remove administrators in System Settings > Users & Groups."
  echo "This deletes the account $name and everything in its home folder. It can't be undone."
  read -r -p "Type the account name to confirm: " ok
  [ "$ok" = "$name" ] || mas_die "Not confirmed; nothing was changed."
  method="$(cat "$USERS_DIR/$name/method" 2>/dev/null)"
  # Revoke a WireGuard key whenever there is one, info pack or not
  mas_wg_remove_peer "$name" || mas_die "Couldn't revoke $name's WireGuard key, so nothing else was changed."
  # sysadminctl leaves the name in these groups, which would let a later account of that name in
  for g in com.apple.access_ssh com.apple.access_screensharing; do
    dscl . -read "/Groups/$g" >/dev/null 2>&1 && sudo dseditgroup -o edit -d "$name" -t user "$g" >/dev/null 2>&1
  done
  # sysadminctl logs each step to stderr; only shown when it fails
  out="$(sudo sysadminctl -deleteUser "$name" 2>&1)"
  if id "$name" >/dev/null 2>&1; then printf '%s\n' "$out" >&2; mas_die "Couldn't remove $name."; fi
  rm -rf "${USERS_DIR:?}/$name"
  echo "Removed $name."
  [ "$method" = wireguard ] || echo "If you shared this Mac with them in Tailscale, also stop sharing it: login.tailscale.com/admin/machines"
}

cmd_users() {
  local sub="${1:-list}"; [ $# -gt 0 ] && shift
  case "$sub" in
    list) users_list ;;
    add) users_add "$@" ;;
    card) users_card "$@" ;;
    remove) users_remove "$@" ;;
    *) mas_die "Unknown users option '$sub'. Try: list, add <name> [\"Full Name\"] [--wireguard], card <name>, remove <name>" ;;
  esac
}

# ---------------------------------------------------------------- token (keychain-free Claude login)
MAS_TOKEN_FILE="$HOME/.mac-ai-server/claude-token"
cmd_token() {
  local t
  case "${1:-status}" in
    status)
      if [ -s "$MAS_TOKEN_FILE" ]; then echo "A setup-token login is saved: new shells use it, even when the keychain is locked."
      else echo "No setup-token login saved. Claude Code uses its normal login (in the keychain)."; fi ;;
    set)
      echo "Claude Code will open a sign-in link and then print a long-lived token. Copy it."
      claude setup-token || mas_die "claude setup-token didn't finish; nothing was saved."
      read -r -s -p "Paste the token here (it isn't shown): " t; echo
      case "$t" in ""|*[[:space:]]*) mas_die "That doesn't look like a token; nothing was saved." ;; esac
      mkdir -p "$(dirname "$MAS_TOKEN_FILE")"
      rm -f "$MAS_TOKEN_FILE"   # a new file, so umask 077 applies (an old one keeps its mode)
      ( umask 077; printf '%s\n' "$t" > "$MAS_TOKEN_FILE" ) || mas_die "Couldn't save $MAS_TOKEN_FILE."
      t=""
      echo "Saved. New Terminal windows, SSH logins and tmux windows use it. Remote Control keeps the normal login."
      echo "(For a tmux window that's already open, run: exec zsh -l)" ;;
    clear) rm -f "$MAS_TOKEN_FILE"; echo "Removed the setup-token login. Claude Code goes back to its normal login." ;;
    *) mas_die "Unknown token option '$1'. Try: status, set, clear" ;;
  esac
}

cmd_handover() {
  local script="${MAS_HANDOVER_SCRIPT:-$MAS_ROOT/handover/prepare-handover.sh}" flag
  case "${1:-}" in
    phase1) flag=--phase1 ;; phase2) flag=--phase2 ;; local) flag="" ;; dry-run) flag=--dry-run ;;
    *) mas_die "Say which step: phase1, phase2, local or dry-run. (dry-run shows what would happen and changes nothing.)" ;;
  esac
  [ -f "$script" ] || mas_die "Handover support isn't installed."
  if [ -n "$flag" ]; then exec /bin/bash "$script" "$flag"; else exec /bin/bash "$script"; fi
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  help|-h|--help) usage ;;
  update)      cmd_update "$@" ;;
  doctor)      cmd_doctor "$@" ;;
  models)      cmd_models "$@" ;;
  tools)       cmd_tools "$@" ;;
  permissions) cmd_permissions "$@" ;;
  handover)    cmd_handover "$@" ;;
  users)       cmd_users "$@" ;;
  token)       cmd_token "$@" ;;
  install)     exec "$MAS_INSTALL_SH" "$@" ;;
  *) usage >&2; echo >&2; mas_die "Unknown command '$cmd'." ;;
esac
