#!/bin/bash
# Unlocks your login keychain in THIS login session. macOS keeps the keychain's locked/unlocked state
# per session: auto-login unlocks it for the desktop (and the tmux session started from it), but every
# SSH login starts with it locked, so Claude Code, gh and anything else that keeps a login in the
# keychain says "not logged in" there.
#   ai-keychain-unlock           unlock now (asks for your password if it can't do it by itself)
#   ai-keychain-unlock --login   at SSH login (~/.zprofile): quiet when there's nothing to do
# By itself: with password-free sudo (agent mode) it reads the auto-login password macOS keeps in
# /etc/kcpassword. Otherwise it asks. The password reaches `security` on standard input, never as an
# argument. Tests only: MAS_SYSROOT prefixes /etc; MAS_KEYCHAIN overrides the keychain path.
KC="${MAS_SYSROOT:-}/etc/kcpassword"
KEYCHAIN="${MAS_KEYCHAIN:-$HOME/Library/Keychains/login.keychain-db}"
login=0; [ "${1:-}" = --login ] && login=1
say() { [ "$login" = 1 ] && [ -n "${2:-}" ] && return 0; printf '%s\n' "$1"; }

unlocked() { security show-keychain-info "$KEYCHAIN" >/dev/null 2>&1; }
q() { local s="${1//\\/\\\\}"; s="${s//\"/\\\"}"; printf '"%s"' "$s"; }   # quote for security -i
try() {  # try <password>: unlock through security's standard input
  printf 'unlock-keychain -p %s %s\n' "$(q "$1")" "$(q "$KEYCHAIN")" | security -i >/dev/null 2>&1
  unlocked
}

[ -f "$KEYCHAIN" ] || { say "No login keychain at $KEYCHAIN." quiet; exit 0; }
unlocked && { say "Your login keychain is already unlocked in this session." quiet; exit 0; }

# 1. By itself: the auto-login password, readable only with admin rights (no prompt: sudo -n).
if [ "$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null)" = "$(id -un)" ] \
   && sudo -n test -f "$KC" 2>/dev/null; then
  pw="$(sudo -n perl -e 'my @k=(0x7D,0x89,0x52,0x23,0xD2,0xBC,0xDD,0xEA,0xA3,0xB9,0x1F);
    local $/; open F,"<",$ARGV[0] or exit 1; binmode F; my @b=unpack("C*",<F>); my $s="";
    for my $i (0..$#b) { my $c=$b[$i]^$k[$i % 11]; last if $c==0; $s.=chr($c) } print $s' "$KC" 2>/dev/null)"
  if [ -n "$pw" ] && try "$pw"; then pw=""; say "Unlocked your login keychain for this session." quiet; exit 0; fi
  pw=""
fi

# 2. Ask, if someone is at a terminal.
if [ -t 0 ] && [ -t 1 ]; then
  echo "Your login keychain is locked in this SSH session, so Claude Code and gh can't read their logins."
  IFS= read -r -s -p "Mac password to unlock it (Enter to skip): " pw; echo
  [ -n "$pw" ] || { echo "Skipped. Unlock later with: mac-ai-server unlock"; exit 1; }
  if try "$pw"; then pw=""; echo "Unlocked."; exit 0; fi
  pw=""; echo "That didn't unlock it. If the keychain's password differs from your login password, see docs/troubleshooting.md."
  exit 1
fi
say "Your login keychain is locked in this session. Unlock it with: mac-ai-server unlock"
exit 1
