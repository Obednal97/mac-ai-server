#!/bin/bash
# One fake for every external command; symlinked under each name (see make-links.sh).
name="$(basename "$0")"
if [ -n "${FAKE_LOG:-}" ]; then echo "$name $*" >> "$FAKE_LOG"; fi
# FAKE_PKILL_WATCH=<path>: pkill also logs whether that path still existed (checks quit-before-delete order)
if [ "$name" = pkill ] && [ -n "${FAKE_PKILL_WATCH:-}" ] && [ -n "${FAKE_LOG:-}" ]; then
  if [ -e "$FAKE_PKILL_WATCH" ]; then echo "pkill-saw present $*" >> "$FAKE_LOG"; else echo "pkill-saw gone $*" >> "$FAKE_LOG"; fi
fi
if [ "$name" = sudo ]; then
  while [ $# -gt 0 ]; do
    case "$1" in
      -v) exit "${FAKE_SUDO_V_RC:-0}" ;;
      -n) [ -n "${FAKE_SUDO_NOPW:-}" ] && exit 1; shift ;;   # FAKE_SUDO_NOPW=1: no password-free sudo
      -A|-S|-k) shift ;;
      -u) shift 2 ;;
      --) shift; break ;;
      -*) shift ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || exit 0
  exec "$@"
fi
# nc -z = nothing listening unless FAKE_NC_RC=0 (never probes the real machine's ports)
[ "$name" = nc ] && exit "${FAKE_NC_RC:-1}"
# launchctl print-disabled: FAKE_LAUNCHCTL_DISABLED=<label> is listed as disabled
if [ "$name" = launchctl ] && [ "${1:-}" = print-disabled ]; then
  [ -n "${FAKE_LAUNCHCTL_DISABLED:-}" ] && printf '\t"%s" => disabled\n' "$FAKE_LAUNCHCTL_DISABLED"
  exit 0
fi
# launchctl print = "service not loaded" unless FAKE_LAUNCHCTL_LOADED=1
if [ "$name" = launchctl ] && [ "${1:-}" = print ] && [ "${FAKE_LAUNCHCTL_LOADED:-0}" != 1 ]; then exit 1; fi
# df is used for real by other tests: pass through unless an output is faked
if [ "$name" = df ] && [ -z "${FAKE_OUT_df:-}" ]; then exec /bin/df "$@"; fi
[ "$name" = launchctl ] && [ "${1:-}" = bootstrap ] && [ -n "${FAKE_LAUNCHCTL_BOOTSTRAP_RC:-}" ] && exit "$FAKE_LAUNCHCTL_BOOTSTRAP_RC"
[ "$name" = visudo ] && exit "${FAKE_VISUDO_RC:-0}"
# brew: FAKE_OUT_brew is the `list` output only. `shellenv` (eval'd by 30-homebrew) and every other
# subcommand print nothing, so tests never execute words from the fake output.
[ "$name" = brew ] && [ "${1:-}" != list ] && exit "${FAKE_RC:-0}"
var="FAKE_OUT_$name"
if [ -n "${!var:-}" ]; then printf '%s\n' "${!var}"; fi
exit "${FAKE_RC:-0}"
