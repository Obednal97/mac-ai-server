#!/bin/bash
# One fake for every external command; symlinked under each name (see make-links.sh).
name="$(basename "$0")"
if [ -n "${FAKE_LOG:-}" ]; then echo "$name $*" >> "$FAKE_LOG"; fi
if [ "$name" = sudo ]; then
  while [ $# -gt 0 ]; do
    case "$1" in
      -v) exit 0 ;;
      -n|-A|-S|-k) shift ;;
      -u) shift 2 ;;
      --) shift; break ;;
      -*) shift ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || exit 0
  exec "$@"
fi
# launchctl print = "service not loaded" unless FAKE_LAUNCHCTL_LOADED=1
if [ "$name" = launchctl ] && [ "${1:-}" = print ] && [ "${FAKE_LAUNCHCTL_LOADED:-0}" != 1 ]; then exit 1; fi
var="FAKE_OUT_$name"
if [ -n "${!var:-}" ]; then printf '%s\n' "${!var}"; fi
exit "${FAKE_RC:-0}"
